#include "app_led_blink.c.coro.h"

/**
 * 识别到 _async 关键字
 * 函数名称: led_blink
 * 返回类型: void
 * 起始行号: 28
 * 终止行号: 34
 * 
 * 参数: 
 *       uint8_t led_id
 *       TickType_t high_level_ticks
 *       uint32_t times
 * 
 * 需要持久化的局部变量: 
 *           uint32_t i
 */

void _cocb_led_blink(struct coro_stu *co);

// ======== 翻译后的函数体 ========
void _co_led_blink(struct coro_stu *father, struct coro_stu *co, uint8_t led_id, TickType_t high_level_ticks, uint32_t times)
{
    struct _coval_led_blink *_prv_data;

    // 如果传进来的对象是空，那么代表外界期望动态创建这个协程的对象
    if(co == NULL){
        // 动态分配
        co = (struct coro_stu *)ctx_mem_alloc(sizeof(struct coro_stu));
        if(co == NULL){
            return ;
        }
        co->prv_data = (struct _coval_led_blink *)ctx_mem_data_alloc(sizeof(struct _coval_led_blink));
        if(co->prv_data == NULL){
            ctx_mem_free(co);
            return ;
        }
        co->step = 0;
    }
    _prv_data = (struct _coval_led_blink *)co->prv_data;

    switch(co->step){
        case 0: goto _colable_led_blink_0;
        case 1: goto _colable_led_blink_1;
        case 2: goto _colable_led_blink_2;
    }

    // 步骤 0 用于初始化
_colable_led_blink_0:
    // 初始化协程对象
    co->father = father;
    if(father != NULL) father->son = co;
    // 配置状态机回调
    ctx_coro_init(co, _cocb_led_blink);

    /* BEGIN: 根据实际情况生成不同的初始化参数变量内容 */
    _prv_data->led_id = led_id;
    _prv_data->high_level_ticks = high_level_ticks;
    _prv_data->times = times;
    /* END: 根据实际情况生成不同的初始化参数和局部变量内容 */


    for(_prv_data->i = 0; _prv_data->i < _prv_data->times; _prv_data->i ++){
        led_set(_prv_data->led_id, 1);
        
        /* BEGIN: 检测到 _await 关键字，替换 */
        _co_delay_ticks(co, NULL, _prv_data->high_level_ticks);
        co->step = 1;
        return ; // 出让
_colable_led_blink_1:
        /* 用户未接收返回值 */
        // free 子协程对象
        ctx_mem_data_free(co->son->prv_data);
        ctx_mem_free(co->son);
        co->son = NULL;
        /* END: 检测到 _await 关键字，替换 */

        led_set(_prv_data->led_id, 0);
        
        /* BEGIN: 检测到 _await 关键字，替换 */
        _co_delay_ticks(co, NULL, _prv_data->high_level_ticks);
        co->step = 2;
        return ; // 出让
_colable_led_blink_2:
        /* 用户未接收返回值 */
        // free 子协程对象
        ctx_mem_data_free(co->son->prv_data);
        ctx_mem_free(co->son);
        co->son = NULL;
        /* END: 检测到 _await 关键字，替换 */

    }
_colable_led_blink_end:
    co->step = 0; // 复位状态机
    if(father == NULL){ // 没有父协程则自己 free 自己
        ctx_mem_data_free(co->prv_data);
        ctx_mem_free(co);
    }else {
        // 唤醒父协程
        ctx_coro_wake(father, 0); // 0 代表 0 tick 后唤醒
    }
}


void _cocb_led_blink(struct coro_stu *co) {
    _co_led_blink(co->father, co, ((struct _coval_led_blink *)co->prv_data)->led_id, ((struct _coval_led_blink *)co->prv_data)->high_level_ticks, ((struct _coval_led_blink *)co->prv_data)->times);
}
