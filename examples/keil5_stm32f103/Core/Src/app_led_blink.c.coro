#include "app_led_blink.c.coro.h"

/**
 * 识别到 _async 关键字
 * 函数名称: led_blink
 * 返回类型: void
 * 起始行号: 28
 * 终止行号: 34
 * 
 * 参数: 
 *       uint8_t led_id
 *       TickType_t high_level_ticks
 *       uint32_t times
 * 
 * 需要持久化的局部变量: 
 *           uint32_t i
 */

// ======== 翻译后的函数体 ========
void _cocb_led_blink(struct coro_stu *co) {
    struct _coval_led_blink *_prv_data = (struct _coval_led_blink *)co->prv_data;

    switch(co->step){
        case 1: goto _colabel_1;
        case 2: goto _colabel_2;
    }


    for(_prv_data->i = 0; _prv_data->i < _prv_data->times; _prv_data->i ++){
        led_set(_prv_data->led_id, 1);


        /* BEGIN: 检测到 _await 关键字，替换 */
        _co_delay_ticks(co, NULL, _prv_data->high_level_ticks);
        co->step = 1;
        return ; // 出让
_colabel_1:
        /* 用户未接收返回值 */
        // free 子协程对象
        ctx_mem_data_free(co->son->prv_data);
        ctx_mem_free(co->son);
        co->son = NULL;
        /* END: 检测到 _await 关键字，替换 */

        led_set(_prv_data->led_id, 0);


        /* BEGIN: 检测到 _await 关键字，替换 */
        _co_delay_ticks(co, NULL, _prv_data->high_level_ticks);
        co->step = 2;
        return ; // 出让
_colabel_2:
        /* 用户未接收返回值 */
        // free 子协程对象
        ctx_mem_data_free(co->son->prv_data);
        ctx_mem_free(co->son);
        co->son = NULL;
        /* END: 检测到 _await 关键字，替换 */

    }
_colabel_end:
    // co->step = 0; // 复位状态机
    if(co->father == NULL){ // 没有父协程则自己 free 自己
        ctx_mem_data_free(co->prv_data);
        ctx_mem_free(co);
    }else {
        // 唤醒父协程
        ctx_coro_wake(co->father, 0); // 0 代表 0 tick 后唤醒
    }
}

struct coro_stu* _co_led_blink(struct coro_stu *father, struct coro_stu *co, uint8_t led_id, TickType_t high_level_ticks, uint32_t times) {
    struct _coval_led_blink *_prv_data;

    // 如果传进来的对象是空，那么代表外界期望动态创建这个协程的对象
    if(co == NULL){
        // 动态分配
        co = (struct coro_stu *)ctx_mem_alloc(sizeof(struct coro_stu));
        if(co == NULL){
            return NULL;
        }
        co->prv_data = (struct _coval_led_blink *)ctx_mem_data_alloc(sizeof(struct _coval_led_blink));
        if(co->prv_data == NULL){
            ctx_mem_free(co);
            return NULL;
        }
    }
    _prv_data = (struct _coval_led_blink *)co->prv_data;

    // 初始化协程对象
    co->father = father;
    // 配置状态机回调
    ctx_coro_init(co, _cocb_led_blink);

    /* BEGIN: 根据实际情况生成不同的初始化参数变量内容 */
    _prv_data->led_id = led_id;
    _prv_data->high_level_ticks = high_level_ticks;
    _prv_data->times = times;
    /* END: 根据实际情况生成不同的初始化参数和局部变量内容 */

    // 运行/启动该任务
    co->step = 0;
    if(father != NULL){
        father->son = co;
        // 如果是 _async 函数使用 _await/_await_static 调用，那么就地运行到出让点，不必等调度器调度，减少调度切换次数
        _cocb_led_blink(co);
    }else {
        // 如果是非 _async 函数调用 _start_async 创建异步任务，那么不立即执行内容，而是等调度器调度，利于业务启停控制
        ctx_coro_wake(co, 0); // 0 代表 0 tick 后唤醒，也就是告诉调度器尽快唤醒
    }

    return co;
}

